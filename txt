<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>PAIR TEMPLATE</title>

<style>

/* =========================
   기본 설정
========================= */

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;

    background: #eeeeee;

    font-family: Arial, sans-serif;
}


/* =========================
   공지창
========================= */

.notice-bg {
    position: fixed;
    inset: 0;

    background: rgba(0, 0, 0, 0.55);

    display: flex;
    justify-content: center;
    align-items: center;

    z-index: 1000;
}

.notice {
    width: min(500px, 85%);
    padding: 30px;

    background: white;

    border-radius: 25px;

    position: relative;

    box-shadow: 0 10px 40px rgba(0,0,0,0.2);
}

.notice h1 {
    margin: 0 0 20px;

    font-size: 24px;
}

.notice-text {
    line-height: 1.7;

    white-space: pre-line;
}

.close-button {
    position: absolute;

    top: 12px;
    right: 18px;

    border: none;
    background: none;

    font-size: 28px;

    cursor: pointer;
}


/* =========================
   전체 편집 영역
========================= */

.editor {
    width: 100%;
    max-width: 650px;

    margin: 0 auto;
    padding: 25px 15px 50px;
}


/* =========================
   실제 페어틀
========================= */

.canvas {
    position: relative;

    width: 100%;

    aspect-ratio: 2 / 3;

    overflow: hidden;

    background:
        linear-gradient(
            180deg,
            #eeeeee,
            #111111
        );
}


/* =========================
   사진 영역
========================= */

.photo {
    position: absolute;

    overflow: hidden;

    cursor: pointer;

    background: #8050c0;
}


/* 사진 */

.photo img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    display: none;
}


/* 사진 넣기 전 글자 */

.photo span {
    position: absolute;

    inset: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    color: white;

    font-size: 14px;

    pointer-events: none;
}


/* =========================
   위쪽 둥근 직사각형
========================= */

.photo-top {
    left: 10%;
    top: 5%;

    width: 80%;
    height: 20%;

    border-radius: 35px;
}


/* =========================
   첫 번째 원
========================= */

.photo-one {
    left: 5%;
    top: 31%;

    width: 24%;
    aspect-ratio: 1 / 1;

    border-radius: 50%;
}


/* =========================
   두 번째 원
========================= */

.photo-two {
    left: 5%;
    top: 52%;

    width: 24%;
    aspect-ratio: 1 / 1;

    border-radius: 50%;
}


/* =========================
   글자 입력
========================= */

.text-box {
    position: absolute;

    left: 50%;

    width: 45%;

    min-height: 50px;

    padding: 5px;

    border: none;
    outline: none;

    background: transparent;

    color: white;

    font-size: 30px;
    font-weight: bold;

    text-align: center;

    resize: none;

    overflow: hidden;
}

.text-box::placeholder {
    color: rgba(255,255,255,0.7);
}


/* 첫 번째 글자 */

.text-one {
    top: 34%;
}


/* 두 번째 글자 */

.text-two {
    top: 55%;
}


/* =========================
   편집 도구
========================= */

.controls {
    margin-top: 20px;

    padding: 20px;

    background: white;

    border-radius: 20px;
}

.controls h2 {
    margin-top: 0;
    margin-bottom: 20px;
}

.control-group {
    margin-bottom: 25px;
}

.control-group label {
    display: block;

    margin-bottom: 10px;

    font-weight: bold;
}


/* =========================
   사진 선택 버튼
========================= */

.photo-button {
    display: block;

    width: 100%;

    padding: 12px;
    margin-bottom: 8px;

    border: none;

    border-radius: 10px;

    background: #eeeeee;

    cursor: pointer;

    font-size: 14px;
}

.photo-button:hover {
    background: #dddddd;
}


/* 파일 선택창 숨기기 */

.file-input {
    display: none;
}


/* =========================
   색상 선택
========================= */

.color-row {
    display: flex;

    align-items: center;

    gap: 10px;
}

input[type="color"] {
    width: 55px;
    height: 40px;

    border: none;

    padding: 0;

    cursor: pointer;
}


/* =========================
   그라데이션 방향
========================= */

input[type="range"] {
    width: 100%;
}


/* =========================
   모바일
========================= */

@media (max-width: 500px) {

    .editor {
        padding: 10px;
    }

    .text-box {
        font-size: 22px;
    }

}

</style>
</head>


<body>


<!-- ==================================================
     공지창
================================================== -->

<div class="notice-bg" id="notice">

    <div class="notice">

        <button
            class="close-button"
            onclick="closeNotice()">
            ×
        </button>


        <h1>PAIR TEMPLATE</h1>


        <!-- 이 부분의 글자를 원하는 대로 수정 -->

        <div class="notice-text">

자유롭게 사용해주세요.

사용 시 출처 표기는 선택입니다.
무단 수정 및 재배포는 삼가주세요.

스탠리 스나이더 OC 사용을 금합니다.

        </div>


    </div>

</div>



<!-- ==================================================
     편집 영역
================================================== -->

<div class="editor">


    <!-- =========================
         실제 페어틀
    ========================== -->

    <div class="canvas" id="canvas">


        <!-- 위쪽 사진 -->

        <div
            class="photo photo-top"
            onclick="openFile('fileTop')">

            <span id="topText">
                사진 넣기
            </span>

            <img id="imageTop" alt="위쪽 사진">

        </div>



        <!-- 첫 번째 원 -->

        <div
            class="photo photo-one"
            onclick="openFile('fileOne')">

            <span id="oneText">
                사진
            </span>

            <img id="imageOne" alt="첫 번째 사진">

        </div>



        <!-- 두 번째 원 -->

        <div
            class="photo photo-two"
            onclick="openFile('fileTwo')">

            <span id="twoText">
                사진
            </span>

            <img id="imageTwo" alt="두 번째 사진">

        </div>



        <!-- 첫 번째 글자 -->

        <textarea
            class="text-box text-one"
            placeholder="글자"
            oninput="resizeText(this)">
        </textarea>



        <!-- 두 번째 글자 -->

        <textarea
            class="text-box text-two"
            placeholder="글자"
            oninput="resizeText(this)">
        </textarea>


    </div>



    <!-- =========================
         편집 메뉴
    ========================== -->

    <div class="controls">

        <h2>페어틀 편집</h2>



        <!-- 사진 -->

        <div class="control-group">

            <label>사진</label>


            <button
                class="photo-button"
                onclick="openFile('fileTop')">
                위쪽 사진 선택
            </button>


            <button
                class="photo-button"
                onclick="openFile('fileOne')">
                첫 번째 원 사진 선택
            </button>


            <button
                class="photo-button"
                onclick="openFile('fileTwo')">
                두 번째 원 사진 선택
            </button>

        </div>



        <!-- =========================
             배경 그라데이션
        ========================== -->

        <div class="control-group">

            <label>배경 그라데이션</label>


            <div class="color-row">

                <span>색상 1</span>

                <input
                    type="color"
                    id="colorTop"
                    value="#eeeeee"
                    oninput="changeGradient()">


                <span>색상 2</span>

                <input
                    type="color"
                    id="colorBottom"
                    value="#111111"
                    oninput="changeGradient()">

            </div>

        </div>



        <!-- =========================
             그라데이션 방향
        ========================== -->

        <div class="control-group">

            <label>
                그라데이션 방향
            </label>


            <input
                type="range"
                id="gradientAngle"

                min="0"
                max="360"

                value="180"

                oninput="changeGradient()">

        </div>


    </div>

</div>



<!-- ==================================================
     사진 파일 선택
================================================== -->

<input
    type="file"
    id="fileTop"
    class="file-input"
    accept="image/*"
    onchange="loadImage(
        this,
        'imageTop',
        'topText'
    )">


<input
    type="file"
    id="fileOne"
    class="file-input"
    accept="image/*"
    onchange="loadImage(
        this,
        'imageOne',
        'oneText'
    )">


<input
    type="file"
    id="fileTwo"
    class="file-input"
    accept="image/*"
    onchange="loadImage(
        this,
        'imageTwo',
        'twoText'
    )">



<script>

/* ==================================================
   공지 닫기
================================================== */

function closeNotice() {

    document.getElementById("notice").style.display = "none";

}



/* ==================================================
   사진 선택창 열기
================================================== */

function openFile(id) {

    document.getElementById(id).click();

}



/* ==================================================
   사진 불러오기
================================================== */

function loadImage(input, imageId, textId) {

    const file = input.files[0];

    if (!file) {
        return;
    }


    const image =
        document.getElementById(imageId);

    const text =
        document.getElementById(textId);


    image.src =
        URL.createObjectURL(file);


    image.style.display =
        "block";


    text.style.display =
        "none";

}



/* ==================================================
   그라데이션 변경
================================================== */

function changeGradient() {

    const colorTop =
        document.getElementById("colorTop").value;


    const colorBottom =
        document.getElementById("colorBottom").value;


    const angle =
        document.getElementById("gradientAngle").value;


    document.getElementById("canvas").style.background =
        `linear-gradient(
            ${angle}deg,
            ${colorTop},
            ${colorBottom}
        )`;

}



/* ==================================================
   글자 입력에 맞춰 높이 조절
================================================== */

function resizeText(element) {

    element.style.height = "auto";

    element.style.height =
        element.scrollHeight + "px";

}

</script>


</body>
</html>
