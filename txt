<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>PAIR TEMPLATE</title>

<style>

/* ───────────────
   전체 페이지
──────────────── */

body {
    margin: 0;
    min-height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;

    background: #eeeeee;

    font-family: Arial, sans-serif;
}


/* ───────────────
   공지창 배경
──────────────── */

.notice-bg {
    position: fixed;
    inset: 0;

    background: rgba(0, 0, 0, 0.55);

    display: flex;
    justify-content: center;
    align-items: center;

    z-index: 1000;
}


/* ───────────────
   공지창
──────────────── */

.notice {
    width: min(500px, 80%);
    padding: 30px;

    background: white;

    border-radius: 25px;

    box-sizing: border-box;

    position: relative;
}


.notice h1 {
    margin-top: 0;
    margin-bottom: 20px;

    font-size: 24px;
}


.notice-text {
    line-height: 1.7;
    white-space: pre-line;
}


/* 닫기 버튼 */

.close-button {
    position: absolute;

    top: 15px;
    right: 18px;

    border: none;
    background: none;

    font-size: 25px;

    cursor: pointer;
}


/* ───────────────
   페어틀
──────────────── */

.pair-template {
    width: 500px;

    padding: 30px;

    background: white;

    box-sizing: border-box;
}


/* ───────────────
   사진 프레임
──────────────── */

.photo-frame {
    width: 100%;
    height: 300px;

    border: 3px solid black;

    /*
       숫자를 키우면
       모서리가 더 둥글어짐
    */
    border-radius: 70px;

    overflow: hidden;

    box-sizing: border-box;

    background: #eeeeee;

    display: flex;
    justify-content: center;
    align-items: center;
}


/* 사진 */

.photo-frame img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    display: none;
}


/* 사진을 넣기 전 문구 */

.photo-placeholder {
    color: #888;
    font-size: 14px;
}


/* 사진 선택 버튼 */

.photo-input {
    margin-top: 15px;

    display: block;
}

</style>
</head>


<body>


<!-- ═════════════════════
     공지창
═════════════════════ -->

<div class="notice-bg" id="notice">

    <div class="notice">

        <button
            class="close-button"
            onclick="closeNotice()">
            ×
        </button>


        <!-- 여기부터 공지 내용을 수정하면 됨 -->

        <h1>PAIR TEMPLATE</h1>

        <div class="notice-text">

자유롭게 사용해주세요.

사용 시 출처 표기는 선택입니다.
무단 수정 및 재배포는 삼가주세요.

스탠리 스나이더 oc 사용을 금합니다.

        </div>

        <!-- 여기까지 공지 내용 -->


    </div>

</div>



<!-- ═════════════════════
     페어틀
═════════════════════ -->

<div class="pair-template">


    <div class="photo-frame">

        <span
            class="photo-placeholder"
            id="placeholder">
            사진을 선택해주세요
        </span>

        <img
            id="photo"
            alt="선택한 사진">

    </div>


    <input
        class="photo-input"
        type="file"
        accept="image/*"
        onchange="loadPhoto(event)">


</div>



<script>

/* ───────────────
   공지 닫기
──────────────── */

function closeNotice() {

    document.getElementById("notice").style.display = "none";

}


/* ───────────────
   사진 불러오기
──────────────── */

function loadPhoto(event) {

    const file = event.target.files[0];

    if (!file) {
        return;
    }


    const photo =
        document.getElementById("photo");

    const placeholder =
        document.getElementById("placeholder");


    photo.src =
        URL.createObjectURL(file);


    photo.style.display = "block";

    placeholder.style.display = "none";

}

</script>


</body>
</html>
