<div class="photo-frame">
  <img src="사진파일.jpg" alt="사진">
</div>
.photo-frame {
  width: 400px;
  height: 250px;

  border: 3px solid #000;
  border-radius: 70px;

  overflow: hidden;
  box-sizing: border-box;
}

.photo-frame img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
